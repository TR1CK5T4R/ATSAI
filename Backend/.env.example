PORT=3001
NODE_ENV=development

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/ats_db
PG_SSL=false                      # set to true for Supabase / Render / Heroku

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRE=15m                    # access token lifespan
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex
JWT_REFRESH_EXPIRE=7d             # refresh token lifespan (httpOnly cookie)

# ── Gemini API ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash     # or gemini-2.5-pro for higher quality (1.5 models are retired)
GEMINI_FAST_MODEL=gemini-2.5-flash-lite  # live interview turns — lightweight for low latency
GEMINI_MOCK=false                 # true → deterministic offline parsing (dev/tests only)

# ── File Storage ───────────────────────────────────────────────────────────────
STORAGE_DRIVER=local              # 'local' today; swap for 's3'/'cloudinary' later
UPLOAD_DIR=uploads                # local driver target dir (relative to Backend/)

# ── Payments ───────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock             # mock | razorpay | stripe (only mock is implemented)
# RAZORPAY_KEY_ID=                # when razorpay.provider.js is added
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=              # when stripe.provider.js is added
# STRIPE_WEBHOOK_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880              # 5 MB in bytes
