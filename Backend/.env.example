PORT=3001
NODE_ENV=development

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/ats_db
PG_SSL=false                      # set to true for Supabase / Render / Heroku

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRE=7d

# ── Gemini API ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash     # or gemini-1.5-pro for higher quality

# ── CORS ───────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880              # 5 MB in bytes
